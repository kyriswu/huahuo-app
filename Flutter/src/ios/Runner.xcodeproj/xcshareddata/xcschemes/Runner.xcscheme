   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Run Prepare Flutter Framework Script"
               scriptText = "set -e&#10;CONFIG=&quot;$SRCROOT/Flutter/Generated.xcconfig&quot;&#10;ENV_FILE=&quot;$SRCROOT/Flutter/flutter_export_environment.sh&quot;&#10;ALLOW_NON_FORMAL=&quot;${HUAHUO_ALLOW_NON_FORMAL_FLUTTER_TARGET:-0}&quot;&#10;case &quot;${CONFIGURATION:-Debug}&quot; in&#10;  Debug) FLUTTER_MODE=debug ;;&#10;  Profile) FLUTTER_MODE=profile; ALLOW_NON_FORMAL=0 ;;&#10;  *) FLUTTER_MODE=release; ALLOW_NON_FORMAL=0 ;;&#10;esac&#10;case &quot;${ACTION:-build}&quot; in install|archive) ALLOW_NON_FORMAL=0 ;; esac&#10;FORMAL_API_BASE=&quot;${HUAHUO_API_BASE_URL:-https://chuda.cc}&quot;&#10;case &quot;$FORMAL_API_BASE&quot; in&#10;  https://*) ;;&#10;  *) echo &quot;HUAHUO_API_BASE_URL must use HTTPS for an Xcode build.&quot; &gt;&amp;2; exit 1 ;;&#10;esac&#10;NEEDS_FORMAL=0&#10;HAS_API_BASE=0&#10;if [ ! -f &quot;$CONFIG&quot; ] || [ ! -f &quot;$ENV_FILE&quot; ]; then&#10;  NEEDS_FORMAL=1&#10;elif [ &quot;$ALLOW_NON_FORMAL&quot; != &quot;1&quot; ]; then&#10;  TARGET=$(/usr/bin/sed -n 's/^FLUTTER_TARGET=//p' &quot;$CONFIG&quot; | /usr/bin/head -n 1)&#10;  if [ &quot;$TARGET&quot; != &quot;lib/main.dart&quot; ]; then NEEDS_FORMAL=1; fi&#10;  DEFINES=$(/usr/bin/sed -n 's/^DART_DEFINES=//p' &quot;$CONFIG&quot;)&#10;  OLD_IFS=&quot;$IFS&quot;&#10;  IFS=','&#10;  for ENCODED in $DEFINES; do&#10;    DECODED=$(printf '%s' &quot;$ENCODED&quot; | /usr/bin/base64 -D 2&gt;/dev/null || true)&#10;    case &quot;$DECODED&quot; in&#10;      HUAHUO_API_BASE_URL=*)&#10;        if [ &quot;$DECODED&quot; = &quot;HUAHUO_API_BASE_URL=$FORMAL_API_BASE&quot; ]; then HAS_API_BASE=1; else NEEDS_FORMAL=1; fi ;;&#10;      BLE_RELAY_HARDWARE_TEST=*|HUAHUO_LOCAL_NUMERIC_AUTH=*|HUAHUO_V3_DEMO_AUTH=*|HUAHUO_V3_INITIAL_ROUTE=*|HUAHUO_CANVAS_DEBUG_REMOTE_DIFF=*|HUAHUO_BOOT_PROBE=*|HUAHUO_V3_OPEN_PROFILE_PANEL=*|HUAHUO_V3_OPEN_ADD_MENU=*) NEEDS_FORMAL=1 ;;&#10;    esac&#10;  done&#10;  IFS=&quot;$OLD_IFS&quot;&#10;  if [ &quot;$HAS_API_BASE&quot; != &quot;1&quot; ]; then NEEDS_FORMAL=1; fi&#10;fi&#10;if [ &quot;$NEEDS_FORMAL&quot; = &quot;1&quot; ]; then&#10;  if [ -f &quot;$ENV_FILE&quot; ]; then . &quot;$ENV_FILE&quot;; fi&#10;  ROOT=&quot;${FLUTTER_ROOT:-}&quot;&#10;  if [ ! -x &quot;$ROOT/bin/flutter&quot; ]; then&#10;    FLUTTER_BIN=$(command -v flutter || true)&#10;    if [ -n &quot;$FLUTTER_BIN&quot; ]; then ROOT=$(cd &quot;$(dirname &quot;$FLUTTER_BIN&quot;)/..&quot; &amp;&amp; pwd); fi&#10;  fi&#10;  if [ ! -x &quot;$ROOT/bin/flutter&quot; ]; then echo &quot;Flutter SDK not found for formal runtime preparation.&quot; &gt;&amp;2; exit 1; fi&#10;  unset DART_DEFINES FLUTTER_TARGET&#10;  cd &quot;$SRCROOT/..&quot;&#10;  &quot;$ROOT/bin/flutter&quot; build ios --&quot;$FLUTTER_MODE&quot; --config-only --target=lib/main.dart --dart-define=HUAHUO_API_BASE_URL=&quot;$FORMAL_API_BASE&quot;&#10;fi&#10;. &quot;$ENV_FILE&quot;&#10;/bin/sh &quot;$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh&quot; prepare&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "97C146ED1CF9000F007C117D"
                     BuildableName = "Runner.app"
                     BlueprintName = "Runner"
                     ReferencedContainer = "container:Runner.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PreActions>
      <BuildActionEntries>
